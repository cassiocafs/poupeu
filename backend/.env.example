PORT=3001
CORS_ORIGIN=http://localhost:5173

# Postgres do Supabase (Settings > Database)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Supabase Auth (Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
# Preencher apenas se o projeto usar assinatura JWT simétrica (HS256).
# Se o projeto usar chaves assimétricas (JWKS/ES256), deixar em branco.
SUPABASE_JWT_SECRET=
# Settings > API > service_role — necessária para excluir a conta do usuário no
# Supabase Auth (DELETE /api/auth/me). Nunca expor esta chave no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# E-mail (Resend) — opcional em desenvolvimento, usa fallback de console se ausente
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=no-reply@poupeu.app
# URL pública do app web (link no e-mail de convite). Opcional.
APP_URL=

# Limite de threads por processo. Importante na hospedagem compartilhada da
# Hostinger, onde o limite "Máximo de processos" conta processos E threads e o
# container expõe dezenas de núcleos (o Prisma abre ~1 thread por núcleo).
# Em produção, configure também nas variáveis de ambiente do painel:
#   UV_THREADPOOL_SIZE=2
#   NODE_OPTIONS=--v8-pool-size=2
UV_THREADPOOL_SIZE=2

# Núcleos aos quais o processo fica preso no arranque (formato do taskset).
# Reduz as threads do Prisma/V8 em hosts com muitos núcleos. Use "off" para
# desativar (ex.: em VPS dedicada, onde não é necessário).
CPU_AFFINITY_LIST=0-3
